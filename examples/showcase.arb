@unique
@flags
enum Permission {
    NONE = 0,
    READ = auto(),
    WRITE = auto(),
    READ_WRITE = READ | WRITE,
}

class AccountLockedError extends Exception {
    account_id: null AccountId = null;
    template = term'Account ${bold}{account_id}${reset} is locked.';
    fallback_template = term'An account is locked.';
}

