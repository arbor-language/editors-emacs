fun main() -> void {
    let message = switch status {
        case 200 => "Success",
        case 404 => "Not found",
        else => "Unexpected response",
    };

    for permission in permissions {
        if permission is null {
            continue;
        }
        write(message);
    }

    try {
        throw AccountLockedError(AccountId(372), log=true);
    } except AccountLockedError as error {
        log(error);
    } finally {
        log("Done");
    }

    warn DeprecatedIn71Warning("old_function");
}
